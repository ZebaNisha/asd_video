# Ignore processed videos and output artifacts
/outputs/*
!/outputs/vgg16_lstm/
!/outputs/vgg16_lstm/subset_allsubjects_20videos/
!/outputs/vgg16_lstm/subset_allsubjects_20videos/child_vgg16_lstm.keras
!/outputs/vgg16_lstm/subset_allsubjects_20videos/vgg16_scaling_params.npz
!/outputs/vgg16_lstm/subset_allsubjects_20videos/child_vgg16_lstm_report.json

# Ignore large npz dataset caches
*.npz
!/outputs/vgg16_lstm/subset_allsubjects_20videos/vgg16_scaling_params.npz

# Ignore dataset files & large archives
/Dataset-2/
/autism_data_anonymized/
features.csv
dataset_stats.json
asd_colab_package.zip

# Ignore top-level model checkpoints directory
/models/*
!/models/lstm/
!/models/lstm/best_lstm_stage.pt

# Ignore logs
/logs/
*.log

# Ignore temporary files & caches
*.tmp
*.pyc
__pycache__/
.pytest_cache/
.ipynb_checkpoints/

# Ignore large raw media files & videos
*.mp4
*.avi
*.mov
*.mkv
*.task
!pose_landmarker_lite.task

# Ignore generated reports and dynamic predictions
/reports/
subject_predictions.csv
scripts/debug.csv
scripts/debug_test.csv

# Ignore local sqlite databases and instances
/instance/
*.db
*.sqlite

# Ignore dynamic user video uploads
/static/uploads/

# Ignore frontend build & dependencies
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# Ignore temporary testing directories
temp_zip_test/
tmp/
